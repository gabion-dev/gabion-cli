; .npmrc
;
; A release published less than seven days ago is not installed: a
; package taken over by an attacker is usually caught within days of the
; malicious release, and this is the window the delay closes. The same
; seven days are the minimum release age of Renovate, which proposes the
; updates of this repository; npm ci installs the lock file as it is and
; is not affected.
min-release-age=7
